{
  "name": "gabriel-portal-independent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node --env-file-if-exists=.env dist/server.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx tests/portable.test.ts && node --import tsx tests/full-flows.mjs",
    "import:backup": "node --env-file-if-exists=.env --import tsx scripts/import-backup.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "firebase": "12.4.0",
    "firebase-admin": "13.5.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
